# Dedicated container only. Do not Include the distribution's sshd configuration.
Port 2222
ListenAddress 0.0.0.0
HostKey /var/lib/jms-executor/ssh_host_ed25519_key
PidFile /run/sshd.pid
UsePAM yes
AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
AllowUsers jms_*
AuthorizedKeysFile /run/jms-executor/authorized_keys
StrictModes yes
DisableForwarding yes
PermitTTY no
PermitTunnel no
PermitUserEnvironment no
PermitUserRC no
ForceCommand jms-executor-session
MaxSessions 1
MaxAuthTries 3
MaxStartups 10:30:30
LoginGraceTime 20
ClientAliveInterval 30
ClientAliveCountMax 3
UseDNS no
PrintMotd no
PrintLastLog no
LogLevel VERBOSE
